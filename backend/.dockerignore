# ==============================================================================
# ITBIS Backend - Docker Build Ignore File
# Build context: ./backend
# Preserves: app/, models/ (*.joblib, *.json), data/ (*.csv), requirements.txt
# ==============================================================================

# Version control
.git/
.gitignore

# Secrets and environment files
.env
.env.*
.env*.local
!.env.example

# Python virtual environments, caches, and bytecode
venv/
env/
.venv/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
.pytest_cache/
**/.pytest_cache/

# Node.js dependencies and logs (Newman API test runner)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Test reports and outputs
tests/reports/
tests/__pycache__/

# Jupyter notebooks and development scripts
notebooks/
*.ipynb
create_notebook.py

# Temporary and agent files
scratch/
.agent/
.agents/

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
