# ==============================================================================
# ITBIS Project Root - Docker Build Ignore File
# Prevents unnecessary files and secrets from entering Docker build contexts
# ==============================================================================

# Version control
.git/
.gitignore

# Secrets and environment files
.env
.env.*
.env*.local
!.env.example

# Python virtual environments, caches, and bytecode
venv/
env/
.venv/
ENV/
backend/venv/
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
.pytest_cache/
backend/.pytest_cache/

# Node.js dependencies and logs
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Next.js and frontend build artifacts
.next/
frontend/.next/
out/
build/

# Test results, reports, and screenshots
test-results/
test-reports/
screenshots/
tests/reports/
tests/screenshots/
frontend/test-results/
frontend/test-reports/
frontend/tests/reports/
frontend/tests/screenshots/
backend/tests/reports/

# Temporary and local scratch files
scratch/
.agent/
.agents/
*.pdf
stitch_itbis_security_intelligence_platform.zip

# IDE and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
