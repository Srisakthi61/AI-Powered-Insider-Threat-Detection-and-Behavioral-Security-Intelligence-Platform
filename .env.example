# ==============================================================================
# ITBIS Environment Variables Template (.env.example)
# Copy this file to .env and configure values for your local environment.
# ==============================================================================

# JWT Security Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_HOURS=8

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=itbis
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/itbis

# MongoDB Database Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=itbis
MONGODB_URL=mongodb://localhost:27017/
